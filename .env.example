# SITE METADATA
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# GOOGLE SHEETS INTAKE (Via Google Apps Script Webhook)
# See: docs/functions/GoogleSheetsIntegration.html
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbwYOUR_SCRIPT_ID/exec"

# EMAIL NOTIFICATIONS (Via Resend API)
# See: docs/functions/EmailDispatch.html
RESEND_API_KEY="re_123456789_abcdefg"
NOTIFICATION_DESTINATION_EMAIL="sales@agency-client.com"
FROM_EMAIL="Inquiries <onboarding@resend.dev>"

# STRIPE CHECKOUT (Optional for E-commerce Archetype)
STRIPE_SECRET_KEY="sk_test_51xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51xxxxxxxxxxxx"

# SANITY CMS (Optional for Corporate/Blog Archetype)
# See: docs/functions/SanityCMSIntegration.html
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
SANITY_REVALIDATE_SECRET="your_shared_webhook_secret_key"
